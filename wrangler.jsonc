{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-ai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Defaults for a plain installation. The Deploy to Cloudflare form shows each
  // of these as a plain-text field filled with the value below, so an operator
  // sees what the deployment runs on and can change it there. Only genuine
  // secrets belong in .dev.vars.example, which that form masks.
  "vars": {
    "SECRET_VAULT_MODE": "local",
    "SECRET_VAULT_LOCAL_KEK_CURRENT_VERSION": "1",
    "ALLOWED_REGISTRATION_EMAILS": ""
  },
  // The deploy script generates DEPLOYMENT_ID once and reuses its deployed binding.
  // Nightly maintenance: retention, expired accounts and authorizations.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./console/dist",
    "not_found_handling": "single-page-application",
    // The API, the MCP endpoint and the OAuth authorization server MCP
    // clients connect through: an MCP client posts to `/mcp`, and a browser
    // navigating there or to `/oauth/authorize` must reach the Worker rather
    // than the console. `/oauth/consent` is the console's own page, so the
    // OAuth paths are listed one by one.
    "run_worker_first": [
      "/v1/*",
      "/mcp",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/mcp",
      "/.well-known/oauth-authorization-server",
      "/oauth/authorize",
      "/oauth/token",
      "/oauth/revoke"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_LIMITER", "class_name": "UserLimiter" },
      { "name": "ORG_QUOTA", "class_name": "OrgQuota" },
      { "name": "ENDPOINT_RATE_LIMITER", "class_name": "EndpointRateLimiter" }
    ]
  },
  // Append-only: every tag below has already been applied to deployed
  // installations, so entries are added and never edited or removed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["OrgQuota"] },
    { "tag": "v3", "new_sqlite_classes": ["EndpointRateLimiter"] }
  ]
  // This file is the complete self-hosted configuration and what the Deploy to
  // Cloudflare button uses. Deployment-specific additions (a custom domain, a
  // fixed D1 database, kms vault mode, a BILLING service binding) belong in a
  // gitignored `wrangler.<profile>.overlay.jsonc`; see the "Deployment
  // profiles" section of docs/content/docs/deployment.mdx. Never add account
  // identifiers or domains here.
}
