{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-ai-gateway-docs",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "docs.appaigateway.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
