{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "types": ["vite/client"],
    // No `baseUrl`: TypeScript 7 removed the option, and the two `paths` entries
    // below already resolve relative to this file, so it was a no-op here.
    // `@shared` is the capability matrix the Worker enforces, imported rather
    // than mirrored. Everything under it is dependency-free by contract — see
    // the module's own header — so nothing server-side reaches this bundle.
    //
    // `@contracts` is the API's own request and response schemas, for the same
    // reason: the console used to keep a second hand-written copy of every wire
    // shape. Only types and `operations.ts` — a table of methods and path
    // builders — are ever imported from it, so no zod reaches this bundle; the
    // runtime schemas live in `operation-schemas.ts`, which nothing here loads.
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../src/shared/*"],
      "@contracts/*": ["../src/contracts/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../src/shared", "../src/contracts"]
}
