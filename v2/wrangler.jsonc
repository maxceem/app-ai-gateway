// The v2 gateway Worker. It runs beside v1 until v1 shuts down, under `/v2/*`.
// A deployment's own name, database id and domains go in a gitignored
// `wrangler.<profile>.jsonc` next to this file, never here.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "app-ai-gateway-v2",
  "main": "src/index.ts",
  // Keep this the same as the v1 `wrangler.jsonc` until v2 replaces it.
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  // The console, built by `pnpm --filter @app-ai-gateway/console-v2 build`
  // into `console/dist/v2/`, so its files answer `/v2/...`. A path with no
  // file reaches the Worker, which answers the console's page for a browser
  // (`src/index.ts`) and JSON for everything else.
  "assets": {
    "directory": "./console/dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Hourly, at minute 17: clean-ups, at 03:17 UTC conversation retention,
  // and at 04:17 UTC the nightly maintenance of the settings
  // (`src/maintenance/nightly.ts`). Open work and the ledger's own clean-up
  // run on each account's ledger object (`src/do/AccountLedger.ts`).
  "triggers": { "crons": ["17 * * * *"] },
  "durable_objects": {
    "bindings": [
      // The end user's limiter: for now, the App Attest replay counter of each install.
      { "name": "END_USER_LIMITER", "class_name": "EndUserLimiter" },
      // Flood limits on the app sign-in routes, per app and network address.
      { "name": "FLOOD_LIMITER", "class_name": "FloodLimiter" },
      // One per app: ledger writes that failed, retried until D1 takes them.
      { "name": "CHARGE_STORE", "class_name": "ChargeStore" },
      { "name": "APP_LIMITER", "class_name": "AppLimiter" },
      { "name": "ACCOUNT_LIMITER", "class_name": "AccountLimiter" },
      // One per app: stored conversations waiting for their batch, written to the
      // optional CONVERSATIONS bucket. Without the bucket it stores nothing.
      { "name": "CONVERSATION_LOG", "class_name": "ConversationLog" },
      { "name": "ACCOUNT_LEDGER", "class_name": "AccountLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EndUserLimiter", "FloodLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["ChargeStore"] },
    { "tag": "v3", "new_sqlite_classes": ["AppLimiter", "AccountLimiter"] },
    { "tag": "v4", "new_sqlite_classes": ["ConversationLog"] },
    { "tag": "v5", "new_sqlite_classes": ["AccountLedger"] }
  ],
  // The vault Worker (`vault/`, plan step 8i): it seals provider keys and
  // sends every call that carries one. It alone holds the vault's settings
  // and secrets (SECRET_VAULT_*, `vault/wrangler.jsonc`); this Worker holds
  // none, so it cannot open a key.
  "services": [{ "binding": "VAULT", "service": "app-ai-gateway-v2-vault" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-ai-gateway-v2",
      "migrations_dir": "migrations"
    }
  ]
}
