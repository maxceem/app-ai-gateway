{
  "name": "@app-ai-gateway/gateway-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsgo --noEmit && wrangler types --check --env-file .dev.vars.example && node --experimental-strip-types scripts/openapi.ts --check",
    "test": "vitest run",
    "types": "wrangler types --env-file .dev.vars.example",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "openapi:generate": "node --experimental-strip-types scripts/openapi.ts",
    "smoke": "node --experimental-strip-types --test smoke/*.smoke.ts",
    "pretest": "node -e \"require('node:fs').mkdirSync('console/dist',{recursive:true})\"",
    "precheck": "node -e \"require('node:fs').mkdirSync('console/dist',{recursive:true})\"",
    "pretypes": "node -e \"require('node:fs').mkdirSync('console/dist',{recursive:true})\""
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@maxceem/cf-auth": "https://github.com/maxceem/cf-auth/releases/download/v1.0.0/maxceem-cf-auth-1.0.0.tgz",
    "@maxceem/cf-kms": "https://github.com/maxceem/cf-kms/releases/download/v0.1.0/maxceem-cf-kms-0.1.0.tgz",
    "@maxceem/worker-mailer": "https://github.com/maxceem/worker-mailer/releases/download/v1.4.4/maxceem-worker-mailer-1.4.4.tgz",
    "@modelcontextprotocol/server": "2.2.0",
    "asn1js": "^3.0.7",
    "cbor-x": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "pkijs": "^3.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.2"
  }
}
