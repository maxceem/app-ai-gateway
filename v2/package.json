{
  "name": "@app-ai-gateway/gateway-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsgo --noEmit && wrangler types --check && node --experimental-strip-types scripts/openapi.ts --check",
    "test": "vitest run",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "openapi:generate": "node --experimental-strip-types scripts/openapi.ts",
    "smoke": "node --experimental-strip-types --test smoke/*.smoke.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@maxceem/cf-auth": "https://github.com/maxceem/cf-auth/releases/download/v0.11.1/maxceem-cf-auth-0.11.1.tgz",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.2"
  }
}
